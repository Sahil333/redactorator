{
  "name": "redactorator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.1.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test": "pnpm typecheck && vitest run && pnpm test:tools && playwright test",
    "test:coverage": "COVERAGE=1 playwright test",
