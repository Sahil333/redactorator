{
  "ignorePatterns": ["vendor/**"],
  "supportEntry": ["engine/globals.ts"],
  "health": {
    "coverage": "coverage/coverage-final.json"
  },
  // Phase 4 audit exemption: docs/designs/auto-mode.md, Detailed
  // Implementation Plan, section 1. V1 removes this entry.
  "overrides": [
    {
      "files": [
        "engine/model/detection.ts",
        "engine/model/identifiers.ts",
        "engine/model/findings.ts",
        "engine/model/textView.ts",
        "engine/detect-protocol/**",
        "engine/detect/**",
        "engine/core/detect-client/client.ts"
      ],
      "rules": {
        "unused-files": "warn",
        "unused-exports": "warn",
        "complexity-crap": "warn"
      }
    }
  ],
  // The same exemption for a new export in an existing file: P0's pack compiler reads it.
  "ignoreExports": [{ "file": "engine/model/match.ts", "exports": ["joinerClass"] }],
  "boundaries": {
    "coverage": { "requireAllFiles": true, "allowUnmatched": ["*.config.ts", "engine/globals.ts"] },
    "zones": [
      { "name": "model", "patterns": ["engine/model/**"] },
      { "name": "storage", "patterns": ["engine/storage/**"] },
      { "name": "pdf-protocol", "patterns": ["engine/pdf-protocol/**"] },
      { "name": "detect-protocol", "patterns": ["engine/detect-protocol/**"] },
      { "name": "api", "patterns": ["engine/api/**"] },
      { "name": "core", "patterns": ["engine/core/**"] },
      { "name": "pdf-apply", "patterns": ["engine/pdf/apply.ts"] },
      { "name": "pdf-write", "patterns": ["engine/pdf/write/**"] },
      { "name": "pdf-prepare-file", "patterns": ["engine/pdf/prepareFile.ts"] },
      { "name": "pdf-prepare", "patterns": ["engine/pdf/prepare/**"] },
      { "name": "pdf", "patterns": ["engine/pdf/**"] },
      { "name": "detect", "patterns": ["engine/detect/**"] },
      { "name": "host-browser", "patterns": ["engine/host-browser/**"] },
      { "name": "app", "patterns": ["app/**"] },
      { "name": "tests", "patterns": ["tests/**"] }
    ],
    "rules": [
      { "from": "model", "allow": [] },
      { "from": "storage", "allow": [] },
      { "from": "pdf-protocol", "allow": ["model"] },
      { "from": "detect-protocol", "allow": ["model"] },
      { "from": "api", "allow": ["model", "storage"] },
      { "from": "core", "allow": ["model", "storage", "api", "pdf-protocol", "detect-protocol"] },
      { "from": "pdf-apply", "allow": ["model", "pdf-protocol", "pdf", "pdf-write"] },
      { "from": "pdf-write", "allow": ["model", "pdf"] },
      { "from": "pdf-prepare-file", "allow": ["model", "pdf-protocol", "pdf", "pdf-prepare"] },
      { "from": "pdf-prepare", "allow": ["model", "pdf"] },
      { "from": "pdf", "allow": ["model", "pdf-protocol", "pdf-apply", "pdf-prepare-file"] },
      { "from": "detect", "allow": ["model", "detect-protocol"] },
      { "from": "host-browser", "allow": ["model", "storage", "pdf-protocol", "api", "core"] },
      { "from": "app", "allow": ["model", "storage", "api", "host-browser"] },
      { "from": "tests", "allow": ["model", "storage", "pdf-protocol", "detect-protocol", "api", "core", "pdf-apply", "pdf", "detect", "host-browser", "app"] }
    ]
  }
}
